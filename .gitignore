*.h5
*.h5ad
*.h5seurat
*.loom
*.mtx
*.rds
*.parquet
*.tar
*.tar.gz
*.zip
*.tiff

# Local logs, QA renders, manuscript drafts and editor files.
logs/
qa_*/
manuscript/
~$*
